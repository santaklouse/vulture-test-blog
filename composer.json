{
    "name": "santaklouse/vulture-blog",
    "description": "Test assignment: a blog built with plain PHP, MySQL and Smarty.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "smarty/smarty": "^5.8"
    },
    "require-dev": {
        "ext-mbstring": "*",
        "scssphp/scssphp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "scss:build": "@php bin/compile-scss.php",
        "scss:watch": "@php bin/watch-scss.php",
        "test": "@php tests/run.php",
        "check": [
            "@scss:build",
            "@test"
        ]
    }
}
